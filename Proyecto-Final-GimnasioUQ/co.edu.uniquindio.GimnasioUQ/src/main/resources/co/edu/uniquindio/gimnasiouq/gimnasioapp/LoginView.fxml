<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.gimnasiouq.gimnasioapp.viewcontroller.LoginViewController">
   <children>
      <Text fx:id="loginTitle" layoutX="250.0" layoutY="86.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Login">
         <font>
            <Font size="24.0" />
         </font>
      </Text>
      <Label layoutX="150.0" layoutY="150.0" text="Username:" />
      <TextField fx:id="usernameField" layoutX="250.0" layoutY="146.0" />
      <Label layoutX="150.0" layoutY="200.0" text="Password:" />
      <PasswordField fx:id="passwordField" layoutX="250.0" layoutY="196.0" />
      <Button layoutX="275.0" layoutY="250.0" mnemonicParsing="false" onAction="#login" text="Login" />
   </children>
</AnchorPane>
