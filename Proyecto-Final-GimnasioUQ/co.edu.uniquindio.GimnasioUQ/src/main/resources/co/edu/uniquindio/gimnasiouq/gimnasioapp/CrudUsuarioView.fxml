<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.ComboBox?>

<AnchorPane prefHeight="572.0" prefWidth="773.0"
            xmlns="http://javafx.com/javafx/20.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.gimnasiouq.gimnasioapp.viewcontroller.CrudUsuarioViewController">

    <children>
        <SplitPane dividerPositions="0.385"
                   layoutX="14.0" layoutY="14.0"
                   orientation="VERTICAL"
                   prefHeight="546.0" prefWidth="747.0">

            <items>

                <!-- ====================== -->
                <!--      FORMULARIO        -->
                <!-- ====================== -->
                <AnchorPane prefHeight="293.0" prefWidth="745.0">
                    <children>

                        <Label layoutX="55.0" layoutY="33.0" text="Nombre:" />
                        <Label layoutX="410.0" layoutY="33.0" text="Identificación:" />
                        <Label layoutX="55.0" layoutY="78.0" text="Edad:" />
                        <Label layoutX="410.0" layoutY="78.0" text="Teléfono:" />
                        <Label layoutX="55.0" layoutY="123.0" text="Tipo Membresía:" />

                        <TextField fx:id="txtNombre"
                                   layoutX="122.0" layoutY="29.0"
                                   prefHeight="26.0" prefWidth="242.0"/>

                        <TextField fx:id="txtIdentificacion"
                                   layoutX="520.0" layoutY="29.0"
                                   prefHeight="26.0" prefWidth="182.0"/>

                        <TextField fx:id="txtEdad"
                                   layoutX="122.0" layoutY="74.0"
                                   prefHeight="26.0" prefWidth="242.0"/>

                        <TextField fx:id="txtTelefono"
                                   layoutX="520.0" layoutY="74.0"
                                   prefHeight="26.0" prefWidth="182.0"/>

                        <ComboBox fx:id="comboMembresia"
                                  layoutX="160.0" layoutY="119.0"
                                  prefHeight="26.0" prefWidth="204.0"/>

                        <Label fx:id="lblExtra1" layoutX="55.0" layoutY="160.0" text="Extra1:" managed="false" visible="false" />
                        <TextField fx:id="txtExtra1" layoutX="122.0" layoutY="156.0" prefHeight="26.0" prefWidth="242.0" managed="false" visible="false" />

                        <Label fx:id="lblExtra2" layoutX="410.0" layoutY="160.0" text="Extra2:" managed="false" visible="false" />
                        <TextField fx:id="txtExtra2" layoutX="520.0" layoutY="156.0" prefHeight="26.0" prefWidth="182.0" managed="false" visible="false" />

                        <Button fx:id="btnNuevo"
                                layoutX="80.0" layoutY="220.0"
                                prefHeight="26.0" prefWidth="133.0"
                                text="Nuevo" onAction="#onActionNuevo"/>

                        <Button fx:id="btnAgregar"
                                layoutX="316.0" layoutY="180.0"
                                prefHeight="26.0" prefWidth="133.0"
                                text="Agregar" onAction="#onActionAgregar"/>

                        <Button fx:id="btnActualizar"
                                layoutX="524.0" layoutY="180.0"
                                prefHeight="26.0" prefWidth="133.0"
                                text="Actualizar" onAction="#onActionActualizar"/>

                        <Button fx:id="btnEliminar"
                                layoutX="316.0"
                                layoutY="220.0"
                                prefHeight="26.0"
                                prefWidth="133.0"
                                text="Eliminar"
                                onAction="#onActionEliminar" />


                    </children>
                </AnchorPane>

                <!-- ====================== -->
                <!--       TABLA             -->
                <!-- ====================== -->
                <AnchorPane prefHeight="100.0" prefWidth="160.0">
                    <children>

                        <TableView fx:id="tableUsuario"
                                   layoutX="14.0" layoutY="14.0"
                                   prefHeight="311.0" prefWidth="723.0">

                            <columns>

                                <TableColumn fx:id="tcNombre"
                                             prefWidth="178.0"
                                             text="Nombre"/>

                                <TableColumn fx:id="tcIdentificacion"
                                             prefWidth="160.0"
                                             text="Identificación"/>

                                <TableColumn fx:id="tcEdad"
                                             prefWidth="120.0"
                                             text="Edad"/>

                                <TableColumn fx:id="tcTelefono"
                                             prefWidth="160.0"
                                             text="Teléfono"/>

                                <TableColumn fx:id="tcMembresia"
                                             prefWidth="120.0"
                                             text="Membresía"/>

                            </columns>
                        </TableView>

                    </children>
                </AnchorPane>

            </items>
        </SplitPane>
    </children>
</AnchorPane>