<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="572.0" prefWidth="773.0" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.gimnasiouq.gimnasioapp.viewcontroller.CoachManagementViewController">
    <children>
        <Label layoutX="55.0" layoutY="33.0" text="Name:" />
        <TextField fx:id="nameField" layoutX="122.0" layoutY="29.0" prefHeight="26.0" prefWidth="242.0" />
        <Label layoutX="410.0" layoutY="33.0" text="ID:" />
        <TextField fx:id="idField" layoutX="520.0" layoutY="29.0" prefHeight="26.0" prefWidth="182.0" />
        <Button onAction="#addCoach" layoutX="316.0" layoutY="80.0" prefHeight="26.0" prefWidth="133.0" text="Add" />
        <Button onAction="#updateCoach" layoutX="460.0" layoutY="80.0" prefHeight="26.0" prefWidth="133.0" text="Update" />
        <Button onAction="#deleteCoach" layoutX="604.0" layoutY="80.0" prefHeight="26.0" prefWidth="133.0" text="Delete" />
        <TableView fx:id="coachTable" layoutX="14.0" layoutY="120.0" prefHeight="432.0" prefWidth="747.0">
